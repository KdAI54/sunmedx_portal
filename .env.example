# Server / Cloudflare Pages Function Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AUTH_SECRET="CHANGE_ME_RANDOM_SECRET"
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Optional Server Email Dispatch (Resend API for AMC agreements & Email Marketing)
RESEND_API_KEY=""
EMAIL_FROM=""

# Public Application URL
APP_URL="MY_APP_URL"

# Data Source Mode: 'local' | 'rest' | 'supabase'
# - local:    Built-in browser persistence (default, zero external setup)
# - rest:     Uses VITE_API_BASE_URL (defaults to '/api' for Cloudflare Pages Functions + D1)
# - supabase: Uses VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY with a 'documents' table
VITE_DATA_SOURCE="local"
VITE_API_BASE_URL="/api"
VITE_AUTH_ENDPOINT=""

# Optional Supabase Configuration (when VITE_DATA_SOURCE="supabase")
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
